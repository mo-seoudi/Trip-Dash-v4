// Provider-neutral operational PostgreSQL schema.
//
// This schema is intentionally independent from the central control plane.
// It can be generated once and used against Supabase PostgreSQL, Neon
// PostgreSQL, or another compatible PostgreSQL host. Organization/user ids are
// stored as identifiers only; there are deliberately no cross-database foreign
// keys back to Tenant, Organization, AppUser, Role, or Membership tables.

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma-operational"
}

datasource db {
  provider = "postgresql"
  url      = env("OPERATIONAL_DATABASE_URL")
}

model Trip {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Canonical control-plane references. These are opaque ids in an operational
  // database; authorization remains the responsibility of the central backend.
  createdByAppUserId              String? @map("created_by_app_user_id")
  tenantId                        String? @map("tenant_id_v2")
  owningSchoolOrganizationId      String? @map("owning_school_organization_id")
  managingOrganizationId          String? @map("managing_organization_id")
  transportProviderOrganizationId String? @map("transport_provider_organization_id")

  // Legacy creator fields retained while existing v4 data is migrated.
  createdBy      String?
  createdByEmail String?
  createdById    Int?

  origin        String?
  tripType      String?
  destination   String?
  date          DateTime?
  departureTime String?
  returnDate    DateTime?
  returnTime    String?
  students      Int?
  staff         Int?
  status        String?
  price         Float?
  notes         String?

  boosterSeatsRequested Boolean  @default(false) @map("booster_seats_requested")
  boosterSeatCount      Int      @default(0) @map("booster_seat_count")
  cancelRequest         Boolean? @default(false)

  // Compatibility snapshots only. Normalized assignments are authoritative
  // after migration. These fields can be removed after migration verification.
  busInfo    Json?
  driverInfo Json?
  buses      Json?

  // There is deliberately no parent/child Trip hierarchy in the canonical
  // operational model. Legacy SubTrip/parentId data is migration input only:
  // one journey remains one Trip and multiple vehicles are TripBusAssignments.
  passengers     TripPassenger[]
  busAssignments TripBusAssignment[]

  @@index([createdAt])
  @@index([status])
  @@index([createdByAppUserId])
  @@index([tenantId])
  @@index([owningSchoolOrganizationId])
  @@index([managingOrganizationId])
  @@index([transportProviderOrganizationId])
  @@map("Trip")
}

model TripBusAssignment {
  id       String @id @default(uuid())
  tripId   Int    @map("trip_id")
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence Int    @default(1)

  busType       String? @map("bus_type")
  seatCapacity  Int?    @map("seat_capacity")
  vehicleNumber String? @map("vehicle_number")
  plateNumber   String? @map("plate_number")
  driverName    String? @map("driver_name")
  driverPhone   String? @map("driver_phone")

  price    Decimal? @db.Decimal(12, 2)
  currency String   @default("AED") @db.VarChar(3)
  status   String   @default("assigned")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  passengerAllocations TripBusPassengerAllocation[]

  @@unique([id, tripId])
  @@unique([tripId, sequence])
  @@index([tripId, status])
  @@map("trip_bus_assignments")
}

model TripPassenger {
  id            Int      @id @default(autoincrement())
  tripId        Int
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  fullName      String
  guardianName  String?
  guardianPhone String?
  pickupPoint   String?
  dropoffPoint  String?
  notes         String?
  checkedIn     Boolean  @default(false)

  payments       TripPassengerPayment[]
  busAllocations TripBusPassengerAllocation[]

  @@unique([id, tripId])
  @@index([tripId])
  @@map("TripPassenger")
}

model TripBusPassengerAllocation {
  busAssignmentId String @map("bus_assignment_id")
  tripPassengerId Int    @map("trip_passenger_id")
  tripId          Int    @map("trip_id")

  // Carry tripId on the allocation itself and use composite foreign keys so a
  // bus assignment and passenger can never be joined across different trips.
  busAssignment TripBusAssignment @relation(fields: [busAssignmentId, tripId], references: [id, tripId], onDelete: Cascade)
  passenger     TripPassenger     @relation(fields: [tripPassengerId, tripId], references: [id, tripId], onDelete: Cascade)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([busAssignmentId, tripPassengerId])
  // A passenger may appear on only one bus within a trip. This is enforced by
  // PostgreSQL rather than relying only on an application-level duplicate check.
  @@unique([tripId, tripPassengerId])
  @@index([tripPassengerId])
  @@index([tripId])
  @@map("trip_bus_passenger_allocations")
}

model TripPassengerPayment {
  id              Int           @id @default(autoincrement())
  tripPassengerId Int
  passenger       TripPassenger @relation(fields: [tripPassengerId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  amountDue       Float
  amountPaid      Float?        @default(0)
  status          String?
  method          String?
  reference       String?
  currency        String?       @default("AED")

  @@index([tripPassengerId])
  @@map("TripPassengerPayment")
}

model BusBooking {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByAppUserId              String? @map("created_by_app_user_id")
  tenantId                        String? @map("tenant_id_v2")
  owningSchoolOrganizationId      String? @map("owning_school_organization_id")
  managingOrganizationId          String? @map("managing_organization_id")
  transportProviderOrganizationId String? @map("transport_provider_organization_id")

  // Legacy compatibility fields.
  createdById    Int?
  createdBy      String?
  createdByEmail String?
  tenant_id      String?
  school_org_id  String?

  title   String?
  purpose String?
  date_start DateTime?
  date_end   DateTime?
  passengers_students Int @default(0)
  passengers_adults   Int @default(0)
  totalPassengers     Int?
  pickup         Json?
  dropoff        Json?
  busesRequested Int?
  busType        String?
  notes          String?
  status         String @default("requested")

  @@index([status])
  @@index([createdByAppUserId])
  @@index([tenantId])
  @@index([owningSchoolOrganizationId])
  @@index([managingOrganizationId])
  @@index([transportProviderOrganizationId])
  @@map("BusBooking")
}
