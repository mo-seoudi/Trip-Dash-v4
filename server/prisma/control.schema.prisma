// Canonical TripDash control-plane schema.
//
// This database owns identity, organizations, access policy, relationships and
// operational data-source metadata. It is deliberately separate from each
// school's operational PostgreSQL database. The existing prisma/schema.prisma
// remains transitional while live v4 data is preserved; do not migrate this
// schema to production until the access-v2 cutover gates are complete.

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma-control"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum OrganizationType {
  SCHOOL_GROUP
  SCHOOL
  BUS_OPERATOR
  SERVICE_PARTNER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RelationshipType {
  BELONGS_TO_GROUP
  TRANSPORT_PROVIDER
  TRIP_MANAGER
  WORKS_WITH_TRANSPORT_PROVIDER
}

enum AccessScopeType {
  PLATFORM
  TENANT
  ORGANIZATION
}

enum IdentityProvider {
  LOCAL
  MICROSOFT_ENTRA
  GOOGLE
  OIDC
  SAML
}

enum DataSourceMode {
  HOSTED
  CUSTOMER_POSTGRES
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  timezone    String   @default("Asia/Dubai")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations          Organization[]
  roleAssignments        RoleAssignment[]
  auditEvents             AuditEvent[]
  operationalDataSources OperationalDataSource[]

  @@map("tenants")
}

model AppUser {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String   @map("display_name")
  status       String   @default("active")
  legacyUserId Int?     @unique @map("legacy_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities      AuthenticationIdentity[]
  memberships     OrganizationMembership[]
  roleAssignments RoleAssignment[]
  auditEvents     AuditEvent[] @relation("AuditActor")
  sessions        AuthSession[]

  @@map("app_users")
}

model AuthenticationIdentity {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  provider        IdentityProvider
  providerSubject String           @map("provider_subject")
  passwordHash    String?          @map("password_hash")
  emailAtProvider String?          @map("email_at_provider")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("authentication_identities")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Organization {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  type         OrganizationType
  displayName  String           @map("display_name")
  fullName     String?          @map("full_name")
  legalName    String?          @map("legal_name")
  abbreviation String?
  slug         String           @unique
  status       String           @default("active")
  parentId     String?          @map("parent_id")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   Organization? @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrganizationHierarchy")

  memberships     OrganizationMembership[]
  roleAssignments RoleAssignment[]

  relationshipsFrom OrganizationRelationship[] @relation("RelationshipFrom")
  relationshipsTo   OrganizationRelationship[] @relation("RelationshipTo")

  operationalDataSources OperationalDataSource[]
  auditEvents             AuditEvent[]

  @@index([tenantId])
  @@index([type])
  @@index([parentId])
  @@map("organizations")
}

model OrganizationRelationship {
  id                 String           @id @default(uuid())
  fromOrganizationId String           @map("from_organization_id")
  toOrganizationId   String           @map("to_organization_id")
  type               RelationshipType
  isPrimary          Boolean          @default(false) @map("is_primary")
  status             String           @default("active")
  validFrom          DateTime?        @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?        @map("valid_until") @db.Timestamptz(6)
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromOrganization Organization @relation("RelationshipFrom", fields: [fromOrganizationId], references: [id], onDelete: Cascade)
  toOrganization   Organization @relation("RelationshipTo", fields: [toOrganizationId], references: [id], onDelete: Cascade)

  @@unique([fromOrganizationId, toOrganizationId, type])
  @@index([fromOrganizationId, type, status])
  @@index([toOrganizationId, type, status])
  @@map("organization_relationships")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  status         MembershipStatus @default(PENDING)
  isPrimary      Boolean          @default(false) @map("is_primary")
  jobTitle       String?          @map("job_title")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  roleId         String          @map("role_id")
  scopeType      AccessScopeType @map("scope_type")
  tenantId       String?         @map("tenant_id")
  organizationId String?         @map("organization_id")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, tenantId, organizationId])
  @@index([userId, isActive])
  @@index([tenantId])
  @@index([organizationId])
  @@map("role_assignments")
}

model OperationalDataSource {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String?        @map("organization_id")
  mode           DataSourceMode @default(HOSTED)
  provider       String         @default("postgresql")
  region         String?
  secretRef      String?        @map("secret_ref")
  isActive       Boolean        @default(true) @map("is_active")
  lastVerifiedAt DateTime?      @map("last_verified_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([organizationId])
  @@map("operational_data_sources")
}

model AuditEvent {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id")
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        AppUser?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
