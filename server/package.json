{
  "name": "school-bus-auth-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "generate": "npm run prisma:generate",
    "test": "node --test test/*.test.mjs",
    "test:access": "node --test test/*.test.mjs",
    "prisma:generate": "prisma generate && prisma generate --schema=prisma/global.schema.prisma && prisma generate --schema=prisma/operational.schema.prisma",
    "prisma:validate": "prisma validate && prisma validate --schema=prisma/global.schema.prisma && prisma validate --schema=prisma/operational.schema.prisma",
    "prisma:operational:generate": "prisma generate --schema=prisma/operational.schema.prisma",
    "prisma:operational:validate": "prisma validate --schema=prisma/operational.schema.prisma",
    "prisma:operational:push": "prisma db push --schema=prisma/operational.schema.prisma --skip-generate",
    "test:operational:smoke": "node scripts/operational-schema-smoke.mjs",
    "verify:operational": "npm run prisma:operational:validate && npm run prisma:operational:generate && npm run prisma:operational:push && npm run test:operational:smoke",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "npm run prisma:generate",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.6",
    "@infisical/sdk": "^4.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
